{
  "name": "@vaka.world/cli",
  "version": "0.1.1",
  "description": "Your mind is the architect. A Claude Code / Codex plugin that makes you reason through design, data flow, and failure modes before the agent writes a line of code.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaka-world/vaka.git"
  },
  "keywords": [
    "learning",
    "architecture",
    "engineering",
    "pair-programming"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "vaka": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "skills",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli/index.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "tsx --test --test-reporter=./test-table-reporter.mjs --test-reporter-destination=stdout tests/**/*.test.ts",
    "test:dist": "npm run build && node --test dist-tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "husky": "9.1.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
